# MongoDB
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=doj_rag

# ─── Cloud LLM: Groq (free tier, fastest) ────────────────────────────────────
# Sign up free at https://console.groq.com → API Keys → Create key.
# When set, Groq is used as the PRIMARY LLM provider (200x faster than local).
# Ollama is kept as fallback if GROQ_API_KEY is absent or empty.
GROQ_API_KEY=
# Available free-tier models (2024): llama-3.1-8b-instant, llama3-8b-8192,
# mixtral-8x7b-32768, gemma2-9b-it. llama-3.1-8b-instant gives best speed+quality.
GROQ_MODEL=llama-3.1-8b-instant
# ─────────────────────────────────────────────────────────────────────────────

# Auth (used to sign login sessions - change this to a random string for
# anything beyond local/personal use; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-this-secret-key-in-production
JWT_EXPIRE_MINUTES=10080

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
# For speed on a normal laptop CPU, a small model matters more than anything
# else here. llama3.2:3b is usable; if responses are still slow, try a
# smaller model instead, e.g.:  ollama pull qwen2.5:1.5b
OLLAMA_MODEL=llama3.2:3b
# Caps output length (fewer tokens = faster on CPU) and context window size,
# and keeps the model resident in memory between requests so it isn't
# reloaded from disk on every message.
OLLAMA_NUM_PREDICT=220
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=30m

# Translation-specific model (see README section on speed). Translation is a
# much simpler task than answering open legal questions, so a small
# dedicated model here is the biggest speed lever for non-English answers.
# Leave blank to reuse OLLAMA_MODEL, or set something smaller, e.g.:
#   ollama pull qwen2.5:1.5b
OLLAMA_TRANSLATE_MODEL=
OLLAMA_TRANSLATE_NUM_PREDICT=300

# Safety-net timeout for the short, non-streaming template calls only (the
# main answer-generation call is now streamed and isn't subject to this -
# see README "Streaming" section). 120s is plenty for a short template.
OLLAMA_TIMEOUT_SECONDS=120

# Speed strategy for general/hybrid (non-exact-match) questions in a
# non-English language. true (default) = one LLM call, directly in that
# language - fastest. false = two calls (English draft, then translate) -
# slower but can be more reliable for some models/languages.
HYBRID_SINGLE_PASS=true

# Faster-Whisper (speech-to-text)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Storage paths (relative to backend/)
DATA_DIR=data/legal_documents
STORAGE_DIR=storage

# CORS
FRONTEND_ORIGIN=http://localhost:5173
